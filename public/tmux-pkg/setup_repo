#!/data/data/com.termux/files/usr/bin/bash

set -e

REPO_NAME="kazam"
REPO_URL="https://kazam.pages.dev/public/tmux-pkg"
KEY_URL="$REPO_URL/pubkey.asc"
SOURCES_FILE="$PREFIX/etc/apt/sources.list.d/$REPO_NAME.list"

echo "Setting up $REPO_NAME repository..."

echo "Importing GPG key..."
curl -fsSL "$KEY_URL" | gpg --dearmor -o "$PREFIX/etc/apt/trusted.gpg.d/$REPO_NAME.gpg"

mkdir -p $PREFIX/etc/apt/sources.list.d
echo "deb [signed-by=$PREFIX/etc/apt/trusted.gpg.d/$REPO_NAME.gpg] $REPO_URL kazam debports" > "$SOURCES_FILE"

echo "✓ Repository added successfully"
echo "Run 'pkg update' to refresh package lists"
